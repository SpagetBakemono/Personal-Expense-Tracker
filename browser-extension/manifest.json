{
  "manifest_version": 3,
  "name": "Expense Tracker Capture",
  "version": "1.0",
  "description": "Capture the current page and send it to your local Expense Tracker to pull out transactions.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
