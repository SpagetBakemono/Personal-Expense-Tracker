# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Optional. Only needed for the statement-import feature (parses pasted
# bank/card statement text into transaction candidates via Gemini's free
# API tier). Get a free key at https://aistudio.google.com.
GEMINI_API_KEY=

# Optional. Only needed for automatic bank sync via Plaid (see
# app/plaid_client.py). Get these from dashboard.plaid.com -> Developers ->
# Keys. Secrets are per environment: PLAID_ENV=sandbox uses
# PLAID_SECRET_SANDBOX (fake test banks, unlimited), PLAID_ENV=production
# uses PLAID_SECRET_PRODUCTION (real banks, counts against your connection
# limit). Access tokens from one environment don't work in the other.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=sandbox

# Required once any account is linked via Plaid: encrypts Plaid access
# tokens before they're stored in the db (see app/token_crypto.py). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes existing links unreadable -- relink them.
PLAID_TOKEN_KEY=

# Optional. Defaults to a local SQLite file if unset -- see app/database.py.
# DATABASE_URL=
